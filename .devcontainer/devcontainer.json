{
  "name": "ghtun",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "postStartCommand": "chmod +x ./.devcontainer/install.sh ./watch.sh ./start_services.sh ./usage-agent.sh ./install-traffic-agent.sh",

  "postAttachCommand": {
    "setup": "sudo bash -c 'cp ./.devcontainer/config.json /etc/config.json || true' && TRAFFIC_API_URL='http://141.11.18.186:3010/api/traffic/push' TRAFFIC_TOKEN='change_me_traffic_token' TRAFFIC_INTERVAL=10 XRAY_INBOUND_TAG='vless-in' ./install-traffic-agent.sh && ./start_services.sh"
  },

  "portsAttributes": {
    "443": {
      "label": "xray",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
